# --- ФУНКЦИИ ВЗАИМОДЕЙСТВИЯ С MOEX API ---

async def fetch_moex_data(ticker: str, days: int = 60) -> pd.DataFrame:
    """
    Асинхронно загружает дневные свечи с Московской Биржи.
    Проверяет сначала рынок акций (shares), затем рынок фьючерсов (forts).
    """
    global http_session
    
    # Считаем дату начала выборки
    start_date = (pd.Timestamp.now() - pd.Timedelta(days=days)).strftime('%Y-%m-%d')
    
    # 1. Пробуем найти инструмент на рынке акций (Т+2)
    url = f"https://moex.com{ticker}/candles.json"
    params = {'from': start_date, 'interval': '24', 'iss.json': 'extended'}
    
    async with http_session.get(url, params=params) as response:
        if response.status != 200:
            return pd.DataFrame()
        raw_data = await response.json()
        
    # Если на рынке акций пусто, пробуем срочный рынок (фьючерсы)
    # Для фьючерсов ищем в режиме RFUD (основной режим клиринга)
    if not raw_data[1].get('candles') or len(raw_data[1]['candles']) == 0:
        url = f"https://moex.com{ticker}/candles.json"
        async with http_session.get(url, params=params) as response:
            if response.status != 200:
                return pd.DataFrame()
            raw_data = await response.json()

    # Парсим JSON-ответ от ISS MOEX
    try:
        candles_list = raw_data[1]['candles']
        if not candles_list:
            return pd.DataFrame()
            
        df = pd.DataFrame(candles_list)
        # Нам нужны только цена закрытия и объем
        df = df[['close', 'volume']].rename(columns={'close': 'Close', 'volume': 'Volume'})
        return df
    except (IndexError, KeyError):
        return pd.DataFrame()

# --- ТЕХНИЧЕСКИЙ АНАЛИЗ ---

def calculate_indicators_and_signal(data: pd.DataFrame, ticker: str) -> str:
    """Вычисляет EMA, RSI и генерирует отчет (выполняется мгновенно в памяти)"""
    if data.empty or len(data) < 22:
        return f"❌ Ошибка: Не удалось получить достаточно данных по тикеру {ticker}."

    # Расчет индикаторов
    data['EMA9'] = data['Close'].ewm(span=9, adjust=False).mean()
    data['EMA21'] = data['Close'].ewm(span=21, adjust=False).mean()
    
    delta = data['Close'].diff()
    gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()
    
    # Защита от деления на ноль при расчете RSI
    rs = gain / loss.replace(0, np.nan)
    data['RSI'] = 100 - (100 / (1 + rs))
    data['RSI'] = data['RSI'].fillna(50) # Дефолтное значение если нет колебаний

    # Извлекаем скаляры
    last_close = float(data['Close'].iloc[-1])
    ema9 = float(data['EMA9'].iloc[-1])
    ema21 = float(data['EMA21'].iloc[-1])
    rsi = float(data['RSI'].iloc[-1])
    volume = float(data['Volume'].iloc[-1])

    signal = "🟡 НАБЛЮДЕНИЕ"
    
    if last_close > ema9 and ema9 > ema21 and rsi < 70:
        signal = "🟢 ПОКУПАТЬ (Тренд вверх)"
    elif last_close < ema9 and ema9 < ema21 and rsi > 30:
        signal = "🔴 ПРОДАВАТЬ (Тренд вниз)"
    elif rsi > 75:
        signal = "⚠️ ПЕРЕКУПЛЕННОСТЬ (Возможна коррекция)"
    elif rsi < 25:
        signal = "⚠️ ПЕРЕПРОДАННОСТЬ (Возможен отскок)"

    # Для фьючерсов объемы могут быть в штуках контрактов, для акций — в рублях/штуках.
    # Выводим как есть, округляя до тысяч/миллионов для красоты.
    vol_str = f"{int(volume/1_000_000)} млн" if volume >= 1_000_000 else f"{int(volume/1_000)} тыс"

    return (f"📊 <b>Анализ {ticker.upper()} (MOEX)</b>\n\n"
            f"Сигнал: {signal}\n"
            f"Цена: {last_close:.2f}\n"
            f"RSI: {rsi:.2f}\n"
            f"EMA(9): {ema9:.2f} | EMA(21): {ema21:.2f}\n"
            f"Объем посл. свечи: {vol_str}")

