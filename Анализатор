        "📉 Фьючерсы: <code>Si-12.26</code> (или краткий код инструмента)."
    )

@dp.message()
async def analyze_message(message: types.Message):
    ticker = message.text.strip().upper()
    
    if len(ticker) > 15:
        await message.answer("❌ Слишком длинный тикер.")
        return

    status_message = await message.answer("⏳ Запрашиваю данные у Московской Биржи...")
    
    try:
        # Асинхронно скачиваем JSON без блокировки потока
        df = await fetch_moex_data(ticker)
        # Обрабатываем данные в памяти
        result_text = calculate_indicators_and_signal(df, ticker)
        
        await status_message.edit_text(result_text, parse_mode="HTML")
    except Exception as e:
        logging.error(f"Ошибка при обработке {ticker}: {e}")
        await status_message.edit_text("❌ Произошла ошибка при анализе рынка.")

# --- ЖИЗНЕННЫЙ ЦИКЛ БОТА ---

async def main():
    global http_session
    # Создаем единую сессию для всех сетевых запросов при старте бота
    http_session = aiohttp.ClientSession()
    
    try:
        await dp.start_polling(bot)
    finally:
        # Обязательно закрываем сессию при выключении бота
        await http_session.close()

if __name__ == "__main__":
    asyncio.run(main())
